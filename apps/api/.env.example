# VedaX AI - API environment
# Copy to .env and fill in your keys.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# MongoDB Atlas (application data + vector search)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=vedax

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# ---- Model providers (fallback order: Groq -> Ollama -> Mock in development) ----

# Cerebras configuration is retained for future use but is currently disabled.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_CHAT_MODEL=gpt-oss-120b
CEREBRAS_VISION_MODEL=gemma-4-31b

# Groq (PRIMARY - fast + reasoning + vision + STT). OpenAI-compatible.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Ollama Cloud (SECONDARY fallback - reasoning + vision). OpenAI-compatible.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_CHAT_MODEL=gpt-oss:120b
OLLAMA_VISION_MODEL=gemma4:31b

# ---- Speech-to-Text (fallback order: Deepgram → Sarvam → Groq) ----

# Deepgram (PRIMARY - general English, fast, smart_format)
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_STT_MODEL=nova-3

# Sarvam (FALLBACK - best for Indian languages / Telugu)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_STT_MODEL=saaras:v4

# ---- Embeddings ----
# EMBEDDING_PROVIDER: jina | gemini | ollama | local | mock
EMBEDDING_PROVIDER=jina
EMBEDDING_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v5-omni-small
EMBEDDING_DIMENSIONS=1024
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072
EMBEDDING_BASE_URL=https://ollama.com/v1
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Storage ----
MEDIA_STORAGE=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Retrieval tuning ----
VECTOR_SEARCH_TOP_K=30
LEXICAL_SEARCH_TOP_K=30
FINAL_TOP_K=6
RRF_K=60

# ---- Telegram (100% free: Bot API has no usage charges) ----
# 1. Chat @BotFather on Telegram → /newbot → paste the token below.
# 2. Generate any random string for the webhook secret.
# 3. After deploying the API publicly, run:
#      uv run python scripts/set_telegram_webhook.py https://<your-api-host>/api/telegram/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---- Uploads ----
MAX_UPLOAD_MB=25
