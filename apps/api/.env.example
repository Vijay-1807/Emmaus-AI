# VedaX AI - API environment
# Copy to .env and fill in your keys.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# MongoDB Atlas (application data + vector search)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=vedax

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# ---- Model providers ----

# Ollama Cloud (primary reasoning + vision). OpenAI-compatible.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_CHAT_MODEL=gpt-oss:120b
OLLAMA_VISION_MODEL=gemma3:27b

# Groq (fast path: classification, routing, reranking, STT). OpenAI-compatible.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo

# Cerebras (optional benchmark/fallback). OpenAI-compatible.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_CHAT_MODEL=llama-3.3-70b

# ---- Embeddings ----
# EMBEDDING_PROVIDER: auto | ollama | local | mock
#   auto   -> try Ollama /embeddings endpoint, then local, then mock
#   ollama -> OpenAI-compatible /embeddings endpoint (Ollama Cloud or local `ollama serve`)
#   local  -> sentence-transformers (requires: uv pip install -e ".[local-embeddings]")
#   mock   -> deterministic offline embeddings (tests/CI only, retrieval quality is meaningless)
EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=https://ollama.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Storage ----
# MEDIA_STORAGE: auto | cloudinary | local
MEDIA_STORAGE=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Observability (optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Retrieval tuning ----
VECTOR_SEARCH_TOP_K=30
LEXICAL_SEARCH_TOP_K=30
FINAL_TOP_K=6
RRF_K=60

# ---- Telegram (optional, Phase 2) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---- Uploads ----
MAX_UPLOAD_MB=25
